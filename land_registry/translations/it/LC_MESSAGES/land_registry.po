# landing.html strings
msgid "Visualize, query, and analyze Italian cadastral data on an interactive map with drawing tools, spatial analysis, and multi-source data loading."
msgstr "Visualizza, interroga e analizza i dati catastali italiani su una mappa interattiva con strumenti di disegno, analisi spaziale e caricamento multi-sorgente."

msgid "Open Map"
msgstr "Apri Mappa"

msgid "Index & Dashboard"
msgstr "Indice & Dashboard"

msgid "Cadastral Browser"
msgstr "Browser Catastale"

msgid "Interactive Mapping"
msgstr "Cartografia Interattiva"

msgid "Leaflet Map"
msgstr "Mappa Leaflet"

msgid "Full-screen interactive map with multiple basemap providers, geocoding, minimap, mouse coordinates, and marker clustering."
msgstr "Mappa interattiva a schermo intero con più provider di basemap, geocodifica, minimappa, coordinate del mouse e raggruppamento dei marcatori."

msgid "Drawing Tools"
msgstr "Strumenti di Disegno"

msgid "Create polygons, circles, rectangles, polylines, and markers directly on the map using Leaflet Draw. Save and reload your drawings."
msgstr "Crea poligoni, cerchi, rettangoli, polilinee e marcatori direttamente sulla mappa con Leaflet Draw. Salva e ricarica i tuoi disegni."

msgid "Zone Management"
msgstr "Gestione Zone"

msgid "Save drawn geometries as named zones with descriptions, colors, and tags. Toggle visibility and export as GeoJSON."
msgstr "Salva le geometrie disegnate come zone con nome, descrizioni, colori e tag. Attiva/disattiva la visibilità ed esporta come GeoJSON."

msgid "Folium Map Generation"
msgstr "Generazione Mappa Folium"

msgid "Server-side map rendering via Folium, embedded in the index page with cadastral overlays and multiple layer support."
msgstr "Rendering della mappa lato server tramite Folium, incorporato nella pagina indice con overlay catastali e supporto multi-layer."

msgid "Italian Cadastral Data"
msgstr "Dati Catastali Italiani"

msgid "Hierarchical Browser"
msgstr "Browser Gerarchico"

msgid "Navigate the full Italian cadastral hierarchy: Regione → Provincia → Comune → file, with expandable tree views and municipality flags."
msgstr "Naviga la gerarchia catastale italiana completa: Regione → Provincia → Comune → file, con viste ad albero espandibili e bandiere dei comuni."

msgid "Advanced Query Engine"
msgstr "Motore di Query Avanzato"

msgid "Filter by Foglio, Particella (single, list, or range), bounding box, point-in-polygon, and date ranges via the cadastral query API."
msgstr "Filtra per Foglio, Particella (singola, lista o intervallo), bounding box, punto nel poligono e intervalli di date tramite l'API di query catastale."

msgid "File Availability Cache"
msgstr "Cache Disponibilità File"

msgid "SQLite-backed cache that tracks which cadastral files exist in S3, with batch checking and configurable TTL."
msgstr "Cache basata su SQLite che traccia quali file catastali esistono in S3, con controllo batch e TTL configurabile."

msgid "Statistics & Coverage"
msgstr "Statistiche e Copertura"

msgid "Real-time counts of regions, provinces, municipalities, and files. Cache status and availability metrics."
msgstr "Conteggi in tempo reale di regioni, province, comuni e file. Stato della cache e metriche di disponibilità."

msgid "Data Sources"
msgstr "Fonti Dati"

msgid "Adjacency Analysis"
msgstr "Analisi Adiacenza"

msgid "Select a polygon and find all adjacent parcels using spatial predicates: touches, intersects, or overlaps."
msgstr "Seleziona un poligono e trova tutte le particelle adiacenti usando predicati spaziali: tocca, interseca o si sovrappone."

msgid "Attribute Table"
msgstr "Tabella Attributi"

msgid "View feature properties in paginated tables with server-side search, sort, and column filtering via Panel Tabulator."
msgstr "Visualizza le proprietà degli elementi in tabelle paginate con ricerca, ordinamento e filtraggio per colonna lato server tramite Panel Tabulator."

msgid "Session State"
msgstr "Stato Sessione"

msgid "Current GeoDataFrame persists across requests. Load, combine, filter, and clear layers within a session."
msgstr "Il GeoDataFrame corrente persiste tra le richieste. Carica, combina, filtra e cancella livelli all'interno di una sessione."

msgid "API Reference"
msgstr "Riferimento API"

msgid "Tech Stack"
msgstr "Stack Tecnologico"

