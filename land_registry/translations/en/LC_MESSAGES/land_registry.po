# landing.html strings
msgid "Visualize, query, and analyze Italian cadastral data on an interactive map with drawing tools, spatial analysis, and multi-source data loading."
msgstr "Visualize, query, and analyze Italian cadastral data on an interactive map with drawing tools, spatial analysis, and multi-source data loading."

msgid "Open Map"
msgstr "Open Map"

msgid "Index & Dashboard"
msgstr "Index & Dashboard"

msgid "Cadastral Browser"
msgstr "Cadastral Browser"

msgid "Interactive Mapping"
msgstr "Interactive Mapping"

msgid "Leaflet Map"
msgstr "Leaflet Map"

msgid "Full-screen interactive map with multiple basemap providers, geocoding, minimap, mouse coordinates, and marker clustering."
msgstr "Full-screen interactive map with multiple basemap providers, geocoding, minimap, mouse coordinates, and marker clustering."

msgid "Drawing Tools"
msgstr "Drawing Tools"

msgid "Create polygons, circles, rectangles, polylines, and markers directly on the map using Leaflet Draw. Save and reload your drawings."
msgstr "Create polygons, circles, rectangles, polylines, and markers directly on the map using Leaflet Draw. Save and reload your drawings."

msgid "Zone Management"
msgstr "Zone Management"

msgid "Save drawn geometries as named zones with descriptions, colors, and tags. Toggle visibility and export as GeoJSON."
msgstr "Save drawn geometries as named zones with descriptions, colors, and tags. Toggle visibility and export as GeoJSON."

msgid "Folium Map Generation"
msgstr "Folium Map Generation"

msgid "Server-side map rendering via Folium, embedded in the index page with cadastral overlays and multiple layer support."
msgstr "Server-side map rendering via Folium, embedded in the index page with cadastral overlays and multiple layer support."

msgid "Italian Cadastral Data"
msgstr "Italian Cadastral Data"

msgid "Hierarchical Browser"
msgstr "Hierarchical Browser"

msgid "Navigate the full Italian cadastral hierarchy: Regione → Provincia → Comune → file, with expandable tree views and municipality flags."
msgstr "Navigate the full Italian cadastral hierarchy: Regione → Provincia → Comune → file, with expandable tree views and municipality flags."

msgid "Advanced Query Engine"
msgstr "Advanced Query Engine"

msgid "Filter by Foglio, Particella (single, list, or range), bounding box, point-in-polygon, and date ranges via the cadastral query API."
msgstr "Filter by Foglio, Particella (single, list, or range), bounding box, point-in-polygon, and date ranges via the cadastral query API."

msgid "File Availability Cache"
msgstr "File Availability Cache"

msgid "SQLite-backed cache that tracks which cadastral files exist in S3, with batch checking and configurable TTL."
msgstr "SQLite-backed cache that tracks which cadastral files exist in S3, with batch checking and configurable TTL."

msgid "Statistics & Coverage"
msgstr "Statistics & Coverage"

msgid "Real-time counts of regions, provinces, municipalities, and files. Cache status and availability metrics."
msgstr "Real-time counts of regions, provinces, municipalities, and files. Cache status and availability metrics."

msgid "Data Sources"
msgstr "Data Sources"

msgid "Adjacency Analysis"
msgstr "Adjacency Analysis"

msgid "Select a polygon and find all adjacent parcels using spatial predicates: touches, intersects, or overlaps."
msgstr "Select a polygon and find all adjacent parcels using spatial predicates: touches, intersects, or overlaps."

msgid "Attribute Table"
msgstr "Attribute Table"

msgid "View feature properties in paginated tables with server-side search, sort, and column filtering via Panel Tabulator."
msgstr "View feature properties in paginated tables with server-side search, sort, and column filtering via Panel Tabulator."

msgid "Session State"
msgstr "Session State"

msgid "Current GeoDataFrame persists across requests. Load, combine, filter, and clear layers within a session."
msgstr "Current GeoDataFrame persists across requests. Load, combine, filter, and clear layers within a session."

msgid "API Reference"
msgstr "API Reference"

msgid "Tech Stack"
msgstr "Tech Stack"

