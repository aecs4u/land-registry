# Copy to .env for local overrides. Profile secrets belong in ignored
# .env.development, .env.testing, .env.staging, or .env.production files.
# scripts/start.sh defaults to development and accepts --env dev|test|staging|production.
#
# Settings load in this order: environments/shared.env, .env, the selected
# environments/<profile>.env, then .env.<profile>. Process environment variables
# take precedence over all files.
ENVIRONMENT=development
